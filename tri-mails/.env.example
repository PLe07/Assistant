# Modèle du fichier .env
# Sur ton Mac : copie ce fichier sous le nom ".env", puis remplis les valeurs.
# Le fichier .env reste sur ton Mac : il n'est JAMAIS envoyé sur GitHub.

# Adresse de la boîte à trier.
# Garde-fou : le script refuse de toucher à une autre boîte.
GMAIL_ATTENDU=

# Modèle Claude utilisé pour trier : sonnet (recommandé) ou opus
MODELE=sonnet

# Jeton Claude longue durée (abonnement). Ne le remplis pas à la main :
# lance  python renouveler_jeton.py  qui l'écrit ici sans l'afficher.
CLAUDE_CODE_OAUTH_TOKEN=
