# --- Secrets : ne JAMAIS envoyer sur GitHub ---
.env
credentials.json
token.json
client_secret*.json

# --- Données personnelles qui restent sur le Mac ---
regles_perso.txt
*.db
*.db-journal
logs/
*.log
PAUSE

# --- Python ---
.venv/
__pycache__/
*.pyc

# --- macOS ---
.DS_Store

# --- Verrou du tri (un seul passage à la fois) ---
.verrou

# --- Expéditeurs jamais archivés (local, peut contenir des noms) ---
jamais_archiver.txt

# --- Assistant : données et réglages personnels (restent sur le Mac) ---
donnees/
/reglages.json
/reglages.json.casse-*
.reglages.*.tmp

# Mesure de couverture (générée par check.sh)
.coverage
.coverage.*

# Nettoyeur de démarrage : sorties réelles du Mac, anonymisées mais personnelles (liste des logiciels)
/tests/demarrage/fixtures/reelles/*
!/tests/demarrage/fixtures/reelles/README.md

# --- Trieur : cache de l'OCR des tests (rejoué à chaque check) ---
tests/trieur/.cache-ocr/
tests/trieur/.cache-corpus/
