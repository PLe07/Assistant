<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.exemple.xml</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Applications/Exemple.app/Contents/MacOS/exemple-agent</string>
		<string>--fond</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>3600</integer>
	<key>WatchPaths</key>
	<array>
		<string>/Users/utilisateur/Documents/Exemple</string>
	</array>
</dict>
</plist>
